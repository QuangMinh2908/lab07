@model IEnumerable<_25DH110979_quangminh.Models.Product>

@{
    ViewBag.Title = "Trang chủ - MyStore";
}

<!-- Banner quảng cáo -->
<div class="jumbotron bg-light p-4 rounded mb-4 border">
    <h1 class="display-4 font-weight-bold text-primary">Chào mừng đến với MyStore!</h1>
    <p class="lead">Hệ thống đặt hàng trực tuyến nhanh chóng, tiện lợi và uy tín.</p>
</div>

<!-- Danh sách sản phẩm -->
<div class="container">
    <h3 class="mb-4 text-uppercase font-weight-bold border-bottom pb-2">SẢN PHẨM NỔI BẬT</h3>
    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="~/Content/images/@item.ProductImage" class="card-img-top" alt="@item.ProductName" style="height: 200px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title font-weight-bold">@item.ProductName</h6>
                            <p class="text-muted small">Danh mục: @(item.Category != null ? item.Category.CategoryName : "Khác")</p>
                            <h5 class="text-danger font-weight-bold mt-auto">@string.Format("{0:N0} VNĐ", item.ProductPrice)</h5>
                            <div class="d-flex gap-2 mt-3">
                                <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-outline-primary btn-sm flex-fill">Chi tiết</a>
                                @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post, new { @class = "flex-fill" }))
                                {
                                    <input type="hidden" name="productId" value="@item.ProductID" />
                                    <button type="submit" class="btn btn-danger btn-sm w-100">Mua ngay</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center my-5">
                <p class="text-muted">Chưa có sản phẩm nào trong Cơ sở dữ liệu.</p>
            </div>
        }
    </div>
</div>