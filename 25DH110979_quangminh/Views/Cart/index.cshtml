@model _25DH110979_quangminh.Models.ViewModel.Cart

@{
    ViewBag.Title = "Giỏ hàng của bạn";
}

<div class="container mt-4">
    <h2>GIỎ HÀNG CỦA BẠN</h2>
    <hr />

    @if (Model != null && Model.Items.Any())
    {
        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td style="width: 100px;">
                            <img src="~/Content/images/@item.ProductImage" class="img-thumbnail" style="height: 70px; object-fit: cover;" />
                        </td>
                        <td class="fw-bold">@item.ProductName</td>
                        <td>@string.Format("{0:N0} VNĐ", item.UnitPrice)</td>
                        <td>@item.Quantity</td>
                        <td class="text-danger fw-bold">@string.Format("{0:N0} VNĐ", item.Total)</td>
                        <td>
                            <a href="@Url.Action("RemoveFromCart", "Cart", new { productId = item.ProductID })" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-light rounded border">
            <h4>Tổng tiền thanh toán: <span class="text-danger fw-bold">@string.Format("{0:N0} VNĐ", Model.TotalValue())</span></h4>
            <div>
                <a href="@Url.Action("Index", "Home")" class="btn btn-secondary me-2">Tiếp tục mua sắm</a>
                <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success btn-lg">XÁC NHẬN ĐẶT HÀNG</a>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h4 class="text-muted">Giỏ hàng của bạn đang trống!</h4>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Quay lại mua sắm</a>
        </div>
    }
</div>