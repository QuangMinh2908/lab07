
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

@model IEnumerable<_25DH110979_quangminh.Models.Product>

@{
    ViewBag.Title = "Trang chủ - MyStore";
}

<div class="container mt-4">
    <!-- Banner -->
    <div class="p-5 mb-4 bg-light rounded-3 border">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-primary">CỬA HÀNG MUA SẮM TRỰC TUYẾN MYSTORE</h1>
            <p class="col-md-8 fs-4">Sản phẩm chính hãng, giao hàng nhanh chóng!</p>
        </div>
    </div>

    <!-- Danh sách sản phẩm -->
    <h3 class="fw-bold mb-4">SẢN PHẨM MỚI NHẤT</h3>
    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="~/Content/images/@item.ProductImage" class="card-img-top" alt="@item.ProductName" style="height: 200px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.ProductName</h5>
                            <p class="text-danger fw-bold fs-5">@string.Format("{0:N0} VNĐ", item.ProductPrice)</p>
                            <div class="mt-auto d-flex gap-2">
                                <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-outline-primary w-50">Chi tiết</a>
                                <a href="@Url.Action("AddToCart", "Cart", new { productId = item.ProductID })" class="btn btn-danger w-50">Mua ngay</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <h4>Chưa có dữ liệu sản phẩm trong Database.</h4>
            </div>
        }
    </div>
</div>